{
  "name": "rankforge",
  "private": true,
  "version": "3.13.0",
  "type": "module",
  "browserslist": [
    "last 3 Chrome versions",
    "last 3 Safari versions",
    "iOS >= 14",
    "last 3 Firefox versions"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pro": "tsc --noEmit && vite build --mode pro",
    "license": "node scripts/make-license.mjs",
    "preview": "vite preview",
    "bundle": "bash scripts/bundle-artifact.sh"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@parcel/config-default": "^2.16.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "buffer": "^6.0.3",
    "html-inline": "^1.2.0",
    "netlify-cli": "^26.2.0",
    "parcel": "^2.16.4",
    "parcel-resolver-tspaths": "^0.0.9",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1"
  }
}
